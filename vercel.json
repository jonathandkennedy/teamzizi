{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/home-search/:path*",
      "destination": "/properties/sale",
      "permanent": true
    },
    {
      "source": "/profile",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/properties/:listing((?!sale$|sold$)[^/]+)",
      "destination": "/properties/sold",
      "permanent": true
    },

    {
      "source": "/blog/adus-in-scripps-ranch-what-homeowners-should-know",
      "destination": "/blog/adu-rules-san-diego-county-2026",
      "permanent": true
    },
    {
      "source": "/blog/del-mar-neighborhoods-explained-beach-village-and-hills",
      "destination": "/neighborhoods/del-mar",
      "permanent": true
    },
    {
      "source": "/blog/4s-ranch-vs-del-sur-which-north-county-community-fits-you",
      "destination": "/neighborhoods/4s-ranch",
      "permanent": true
    },
    {
      "source": "/blog/townhome-vs-single-family-in-4s-ranch",
      "destination": "/neighborhoods/4s-ranch",
      "permanent": true
    },
    {
      "source": "/blog/is-4s-ranch-a-smart-long-term-home-purchase",
      "destination": "/neighborhoods/4s-ranch",
      "permanent": true
    },
    {
      "source": "/agent/deanna-colby",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/blog/mello-roos-vs-hoa-in-4s-ranch",
      "destination": "/neighborhoods/4s-ranch",
      "permanent": false
    },
    {
      "source": "/testimonials",
      "destination": "/team",
      "permanent": false
    },
    {
      "source": "/agent/coby-herzog",
      "destination": "/team",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js|img)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
